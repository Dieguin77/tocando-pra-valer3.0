# API Keys e configurações

# Genius API - Para buscar informações e letras de músicas
# 1. Crie uma conta em https://genius.com/api-clients
# 2. Clique em "Create an API Client"
# 3. Preencha os dados do seu aplicativo
# 4. Copie o "Client Access Token"
# 5. Cole aqui:
VITE_GENIUS_ACCESS_TOKEN=seu_token_aqui

# Vagalume API - Para buscar letras de músicas
# 1. Crie uma conta em https://www.vagalume.com.br/api/
# 2. Gere uma chave de API
# 3. Cole aqui:
VITE_VAGALUME_API_KEY=sua_chave_aqui

# EmailJS - Para enviar e-mails de notificação
# 1. Crie uma conta em https://www.emailjs.com/
# 2. Adicione um novo serviço (ex: Gmail)
# 3. Crie os templates de e-mail (confirmação, notificação de admin, etc.)
# 4. Encontre suas credenciais em "Account" -> "API Keys"
VITE_EMAILJS_SERVICE_ID=seu_service_id
VITE_EMAILJS_TEMPLATE_CONFIRMACAO=seu_template_id
VITE_EMAILJS_TEMPLATE_NOTIF_ADMIN=seu_template_id
VITE_EMAILJS_TEMPLATE_APROVACAO=seu_template_id
VITE_EMAILJS_TEMPLATE_REJEICAO=seu_template_id
VITE_EMAILJS_PUBLIC_KEY=sua_public_key
VITE_ADMIN_EMAIL=seu_email_de_admin

# Spotify API (opcional - para dados de artistas)
# Acesso em https://developer.spotify.com
VITE_SPOTIFY_CLIENT_ID=seu_client_id
VITE_SPOTIFY_CLIENT_SECRET=seu_client_secret
# =============================================================================
# BACKEND DE CIFRAS - Escolha UMA das opções abaixo
# =============================================================================

# OPÇÃO 1: FORMSPREE (Mais simples - recebe por email)
# 1. Crie conta gratuita em https://formspree.io
# 2. Crie um novo form e copie o endpoint ID (ex: "xyzabcde")
# Gratuito: 50 envios/mês
VITE_FORMSPREE_ENDPOINT_ID=seu_endpoint_id

# OPÇÃO 2: GOOGLE SHEETS (Visual - veja cifras na planilha)
# 1. Crie uma planilha no Google Sheets
# 2. Adicione as colunas: ID, Titulo, Artista, Compositor, Tom, Dificuldade, Cifra, Comentarios, DataCriacao, Status
# 3. Vá em Extensões > Apps Script e cole o código do cifrasService.js
# 4. Implante como Web App e copie a URL
# Gratuito e ilimitado
VITE_GOOGLE_SHEETS_WEBAPP_URL=sua_url_do_webapp

# OPÇÃO 3: SUPABASE (Database completo com painel admin)
# 1. Crie projeto gratuito em https://supabase.com
# 2. Execute o SQL do cifrasService.js para criar a tabela
# 3. Copie URL e anon key de Settings > API
# Gratuito: 500MB storage, 2GB bandwidth
VITE_SUPABASE_URL=sua_supabase_url
VITE_SUPABASE_ANON_KEY=sua_anon_key